<Window x:Class="ArrayWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Одновимірний масив (варіант 2)"
        Width="760" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontSize="14">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="CellsPanel">
            <WrapPanel/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="CellTemplate">
            <Border Background="{Binding Fill}" BorderBrush="#9E9E9E" BorderThickness="1"
                    Width="60" Margin="2" Padding="2,3">
                <StackPanel>
                    <TextBlock Text="{Binding IndexText}" FontSize="11" Foreground="#757575"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Масив з n випадкових чисел з діапазону [-2.9; 60.3], 1 дробовий знак"
                   FontSize="16" FontWeight="SemiBold"/>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Label Content="Кількість елементів n:" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxN" Width="80" Margin="8,0" Padding="4,2"
                     VerticalContentAlignment="Center"/>
            <Button x:Name="GenerateButton" Content="Згенерувати та обробити" Padding="14,4"
                    Click="GenerateButton_Click"/>
        </StackPanel>

        <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock Text="Згенерований масив:" FontWeight="SemiBold"/>
            <ItemsControl x:Name="SourceArray" Margin="0,6,0,0"
                          ItemsPanel="{StaticResource CellsPanel}" ItemTemplate="{StaticResource CellTemplate}"/>
            <TextBlock x:Name="MinMaxText" Margin="0,8,0,0"/>

            <TextBlock Text="1) Добуток індексів елементів між мінімальним і максимальним:"
                       FontWeight="SemiBold" Margin="0,14,0,0"/>
            <TextBlock x:Name="ProductText" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="2) Масив після впорядкування елементів між мінімальним і максимальним за спаданням:"
                       FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap"/>
            <ItemsControl x:Name="SortedArray" Margin="0,6,0,0"
                          ItemsPanel="{StaticResource CellsPanel}" ItemTemplate="{StaticResource CellTemplate}"/>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Border Width="16" Height="16" Background="#BBDEFB" BorderBrush="#9E9E9E" BorderThickness="1"/>
                <TextBlock Text="мінімальний" Margin="6,0,18,0"/>
                <Border Width="16" Height="16" Background="#FFCDD2" BorderBrush="#9E9E9E" BorderThickness="1"/>
                <TextBlock Text="максимальний" Margin="6,0,18,0"/>
                <Border Width="16" Height="16" Background="#FFF59D" BorderBrush="#9E9E9E" BorderThickness="1"/>
                <TextBlock Text="елементи між ними" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
